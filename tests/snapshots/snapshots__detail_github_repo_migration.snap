</svg> All keys
  </a>

  

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-semibold tracking-tight">GitHub – repo migration (on demand)</h1>
      <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <span class="badge state-badge" data-state="on-demand"><span class="state-dot"></span>On demand</span>
        <span class="badge" data-variant="outline">github</span>
        <span>owned by david</span>
        <code class="text-xs">github-repo-migration</code>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      
      
      <a class="btn"  href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer" data-track-open="/keys/github-repo-migration/opened" title="Opening the create page is recorded">
            Create <svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M15 3h6v6" />
  <path d="M10 14 21 3" />
  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
</svg>
          </a>
      
      
      
    </div>
  </div>

  

  <div class="grid gap-4 md:grid-cols-2">
    
    <div class="card">
      <header>
        <h2>On demand</h2>
        <p>Created when needed and deleted right after. Never stored, so there is nothing to expire or alert on.</p>
      </header>
      <section>
        <dl class="kv">
          <dt>Last opened</dt>
          <dd>12d ago <span class="text-muted-foreground">by david</span></dd>
        </dl>
        <p class="mt-3 text-sm text-muted-foreground">Opening the provider's create page with <em>Create</em> is recorded here and as a Kubernetes Event. Whether a token was actually created there is not visible to this app.</p>
      </section>
    </div>
    

    <div class="card">
      <header>
        <h2>Setup</h2>
        <p>How the key is configured at the provider.</p>
      </header>
      <section class="flex flex-col gap-3">
        
        <div class="flex flex-wrap gap-1.5">
          <span class="badge" data-variant="secondary">administration: write</span><span class="badge" data-variant="secondary">contents: write</span>
        </div>
        
        
      </section>
    </div>

    <div class="card">
      <header>
        <h2>Targets</h2>
        <p>Written automatically when a new key is submitted.</p>
      </header>
      <section>
        
        
        <p class="text-sm text-muted-foreground">None: on-demand keys are never stored.</p>
        
        
      </section>
    </div>

    <div class="card">
      <header>
        <h2>Update by hand</h2>
        <p>Places the key must be changed manually after rotating.</p>
      </header>
      <section>
        
        <p class="text-sm text-muted-foreground">Nothing listed.</p>
        
      </section>
    </div>
  </div>

  <div class="card">
    <header>
      <h2>History</h2>
      <p>The last 1 events.</p>
    </header>
    <section>
      
      <div class="table-container">
        <table class="table">
          <thead><tr><th>When</th><th>What</th><th>By</th><th>Expires</th></tr></thead>
          <tbody>
            
            <tr><td>2026-09-14 12:00 UTC</td><td>Opened create page</td><td>david</td><td>—</td></tr>
            
          </tbody>
        </table>
      </div>
      
    </section>
  </div>
</div>

  </main>
  


  <dialog id="command-palette" class="command-dialog" aria-label="Search keys">
    <div class="command">
      <header>
        <svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m21 21-4.34-4.34" />
  <circle cx="11" cy="11" r="8" />
</svg>
        <input type="search" name="q" placeholder="Search keys…" autocomplete="off" aria-label="Search keys"
               hx-get="/search" hx-trigger="input changed delay:150ms, search, palette-open" hx-target="#command-results">
      </header>
      <div id="command-results" role="menu" aria-orientation="vertical" data-empty="No keys found."></div>
    </div>
  </dialog>
